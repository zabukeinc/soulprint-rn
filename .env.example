# Local development only. Android emulator uses 10.0.2.2 for the host machine.
# iOS Simulator is also supported by the API client when this value is used.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3111/v1
EXPO_PUBLIC_APP_ENV=development

# Production builds do not use this file. Their values are defined in eas.json.
# EXPO_PUBLIC_API_URL=https://api.astrovy.space/v1
# EXPO_PUBLIC_APP_ENV=production
